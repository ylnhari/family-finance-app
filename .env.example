# Optional secrets — copy to .env (gitignored). The core app runs fine with
# no .env at all; these only unlock optional features (Gemini AI helpers,
# live broker/NSE sync for the investments dashboard, ntfy.sh phone pushes).
# Leave any of these blank to keep the corresponding feature off / manual.
#
# Broker accounts are created in the /invest UI (or its API) — NOT by adding
# lines here. This file only supplies CREDENTIALS for an account id you've
# already created there. Naming convention: an account with id X (e.g.
# "kite-3") reads X_API_KEY, X_API_SECRET, etc., with X uppercased and
# hyphens turned to underscores (kite-3 -> KITE_3_API_KEY). kite-1 / kite-2 /
# upstox-1 below are illustrative example ids only — a fresh install starts
# with ZERO accounts; nothing is pre-created. Full walkthrough (Kite/Upstox
# app creation, exact redirect URLs, first login, troubleshooting):
# docs/BROKER-SETUP.md.
#
# This file also has a fallback: config.py additionally loads a PARENT-folder
# .env (one level above this repo) for shared keys, useful if you keep
# several local projects' secrets in one place. Most users can ignore this —
# a standalone clone has no unrelated parent .env to pick up.

# Optional — powers the payslip/goal-price AI helpers in the finance tracker.
# Get a free key at https://aistudio.google.com/apikey (Google AI Studio).
# Leave blank to keep those endpoints off (they degrade gracefully).
GEMINI_API_KEY=

# Zerodha Kite Connect — create a FREE "Personal" app per account at
# https://developers.kite.trade, logged in as that account. (Kite Connect's
# paid "Connect" tier, ~Rs 500/month per app per Zerodha's own pricing page,
# is NOT needed here — portfolio/holdings access is included in the free
# Personal tier; the paid tier only adds live/historical market-data
# endpoints this app doesn't call.) One app per Kite account you connect.
# Redirect URL for the app:  http://127.0.0.1:<port>/auth/kite/kite-1/callback
#   (<port> = the port this app serves on: your ports.json entry or --port;
#   default 8765. Must match exactly — see docs/BROKER-SETUP.md if the
#   broker rejects the callback.)
KITE_1_API_KEY=
KITE_1_API_SECRET=
# Redirect URL:              http://127.0.0.1:<port>/auth/kite/kite-2/callback
KITE_2_API_KEY=
KITE_2_API_SECRET=

# OPTIONAL — only for the unattended morning refresh (refresh_tokens.py).
# Leave blank to keep clicking "Login & sync" by hand. USER_ID is the Zerodha
# client ID (e.g. AB1234); TOTP_SECRET is the base32 seed behind the external-
# 2FA authenticator QR (Console > Settings > Password & security > External
# 2FA / TOTP), NOT a live 6-digit code. These are your full login — .env
# only, and read docs/NOTIFICATIONS.md's security section before setting
# them: this trio can bypass 2FA entirely, a materially bigger risk than an
# API key/secret alone.
KITE_1_USER_ID=
KITE_1_PASSWORD=
KITE_1_TOTP_SECRET=
KITE_2_USER_ID=
KITE_2_PASSWORD=
KITE_2_TOTP_SECRET=

# Upstox — create an app at https://account.upstox.com/developer/apps
# (app registration and read-only holdings access are free per Upstox's own
# developer docs; verify current terms at signup since Upstox has run
# date-limited promotional pricing pages for order-placement API usage,
# which this app doesn't do — it only reads holdings).
# Redirect URL:              http://127.0.0.1:<port>/auth/upstox/upstox-1/callback
#   Must match exactly what you register — Upstox's OAuth docs reject a
#   mismatched redirect_uri outright. Use 127.0.0.1 literally, not
#   "localhost" — the app always builds this URL from 127.0.0.1 when it
#   talks to Upstox (see docs/BROKER-SETUP.md).
UPSTOX_1_API_KEY=
UPSTOX_1_API_SECRET=
# OPTIONAL — a ~1-year read-only Analytics Token removes Upstox's daily login
# entirely: generate once at Developer Apps > Analytics > Generate Token, paste
# it here. Reading holdings with it REQUIRES a Static IP configured on the app
# (Developer Apps > Static IP = your connection's public IP; per Upstox's
# docs, static IPs can only be changed once a week). Leave blank to keep the
# manual "Login & sync" button instead. See docs/BROKER-SETUP.md.
UPSTOX_1_ANALYTICS_TOKEN=

# Which Kite account's Zerodha login owns the Coin (mutual fund) folio. Must
# name an account id that actually exists in your account registry — the app
# should tell you clearly if it doesn't, rather than silently doing nothing.
COIN_SOURCE_ACCOUNT=kite-1

# ntfy.sh topic for daily_brief.py / refresh_tokens.py phone pushes — pick
# something random and hard to guess; per ntfy's own docs, topic names are
# public, so the topic name is effectively the password. Subscribe once on
# your phone (ntfy app) or in a browser at https://ntfy.sh/<topic>. Full
# setup + what gets sent + scheduling: docs/NOTIFICATIONS.md.
NTFY_TOPIC=
